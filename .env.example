# GEMINI_API_KEY: Required only if Gemini AI API calls are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this app is hosted (e.g. Cloud Run service URL).
APP_URL="MY_APP_URL"

# HTTP Server Port (Cloud Run sets PORT automatically, default 3000 locally)
PORT=3000
NODE_ENV=development

# Cloud SQL PostgreSQL connection (Object Method - never use DATABASE_URL)
# AI Studio Preview: /app/cloudsql/<PROJECT_ID>:<REGION>:<INSTANCE>
# Google Cloud Run: /cloudsql/<PROJECT_ID>:<REGION>:<INSTANCE>
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_POOL_MAX=10

# Drizzle Kit Admin Credentials (used only for manual schema tooling, never at runtime)
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Supabase Storage configuration (REQUIRED in NODE_ENV=production; stored in Google Secret Manager)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET="almos-garment-photos"

